@article{KASAPOVIC20251059,
    abstract = {Purpose
This paper explores whether there are differences in the information behaviour of high school students when choosing a higher education institution (HEI) based on the educational attainment of their parents. We focus on the social factors of information behaviour in the post-conflict society of Bosnia and Herzegovina.
Design/methodology/approach
We use Bourdieu’s social theory to demonstrate the need for a deeper inclusion of the social context for a more comprehensive understanding of information behaviour, and Bronfenbrenner’s theory of human development to propose a model for social interventions to reduce information inequality. Using the concept of cultural capital (CC), Bourdieu explains the reproduction of social inequalities through the educational system. We apply this concept to explain information behaviour when choosing an HEI as a partially socially conditioned behaviour. In a quantitative study, we investigate how the institutionalized form of parents’ CC is reflected in their children’s information behaviour in selecting an HEI.
Findings
There are two different patterns of information behaviour of high school seniors when choosing an HEI based on the institutionalized CC of their parents, especially fathers. The group of respondents whose fathers have a higher academic degree shows a different “taste” in using information sources and channels compared to the group whose fathers have a lower degree. These findings suggest that the lack of CC functions as an internalized structural barrier that shapes information behaviour on an unconscious level, and that social context operates on multiple levels.
Originality/value
This is one of the first papers that applies Bourdieu’s concept of CC and Bronfenbrenner’s ecological systems theory to understand the social dimension of information behaviour.},
    author = {Indira Kasapović},
    doi = {https://doi.org/10.1108/JD-01-2025-0027},
    issn = {0022-0418},
    journal = {Journal of Documentation},
    keywords = {Career decision-making, Choice of higher education institution, Cultural capital, High school students, Information behaviour, Information capital, Information inequality, Social context},
    number = {4},
    pages = {1059-1077},
    title = {Choice or inevitability: social context and the role of cultural capital in information behaviour of young people in career decision-making},
    url = {https://www.sciencedirect.com/science/article/pii/S0022041825000190},
    volume = {81},
    year = {2025}
}

@article{SCHULZ2025102900,
    abstract = {Background
Chronic meningococcal disease is a rare and under-recognized manifestation of Neisseria meningitidis infection. Unlike acute meningococcal infections, its presentation is insidious, leading to diagnostic delays. We conducted a systematic review to better characterize its clinical, microbiological, and epidemiological profile.
Methods
A systematic review was performed in accordance with PRISMA 2020 guidelines and registered in PROSPERO (CRD42024608035). We searched Excerpta Medica, National Library of Medicine, Web of Science, Google Scholar, and bibliographies for cases reported since 1960 using the terms “chronic meningococcemia” or “chronic meningococcal disease.” Eligible cases involved previously apparently healthy individuals with N. meningitidis isolated from a normally sterile site. Two reviewers independently extracted data on demographics, clinical features, diagnostics, microbiology, treatment, and outcomes.
Results
A total of 126 cases from 97 reports were included. Most patients (median age: 21 years) presented with recurrent fever (98 %), non-blanching skin lesions (95 %), and musculoskeletal symptoms (90 %) over a period of ≥ 10 days. In over two-thirds of cases, symptoms followed a relapsing-remitting pattern, with alternating episodes of fever, rash, and joint involvement. Diagnosis was delayed longer in adults than in children (P < 0.0001). Blood cultures were positive in 77 % of cases; molecular testing and skin biopsy improved diagnostic yield. N. meningitidis serogroup B (58 %) and C (31 %) were most common. Meningeal signs were largely absent (94 %). Antimicrobial therapy led to complete recovery without sequelae in all patients. Testing for inherited susceptibility was conducted in 52 cases and revealed abnormalities - primarily complement deficiencies - in 13 (23 %) of them.
Conclusions
Chronic meningococcal disease should be considered in individuals with relapsing fever, vasculitic skin lesions, and joint involvement, especially when cultures are negative or symptoms mimic viral or autoimmune conditions. Early use of molecular diagnostics and awareness of characteristic patterns may improve recognition. The term "relapsing-remitting meningococcal disease" may better reflect its clinical nature.},
    author = {Lukas P. Schulz and Beatrice Gatti and Gregorio P. Milani and Sebastiano A.G. Lava and Camilla Lavagno and Mario G. Bianchetti and Gabriel Bronz and Lisa Kottanattu and Pietro Camozzi and Pietro B. Faré},
    doi = {https://doi.org/10.1016/j.jiph.2025.102900},
    issn = {1876-0341},
    journal = {Journal of Infection and Public Health},
    keywords = {Chronic meningococcal disease, Relapsing fever, Neisseria meningitidis, Vasculitic skin lesions, Complement deficiency},
    number = {11},
    pages = {102900},
    title = {Chronic meningococcal disease: Systematic literature review},
    url = {https://www.sciencedirect.com/science/article/pii/S1876034125002497},
    volume = {18},
    year = {2025}
}

@article{KATEEL2025183,
    abstract = {Summary
Aged type 2 diabetes mellitus (T2DM) patients are linked with lower serum levels of total antioxidant activity, magnesium and zinc, particularly under uncontrolled hyperglycemia. Uncontrolled oxidative stress is an established contributor to diabetic complications. Magnesium is a cofactor for ∼600 enzymes, while zinc is a part of ∼3000 human proteins, essential for intermediary metabolism. A multi-targeted approach combining β-carotene, Magnesium and Zinc (BMZ) with metformin or vitamin E, Magnesium and Zinc (EMZ) with metformin for daily use in aged rats with T2DM identified astonishing findings compared to metformin monotherapy. Over three months, compared to metformin monotherapy, BMZ with metformin provided excellent glycemic control, outstanding protection against potential neuropathy and sensorimotor coordination, maintained robust retinal integrity and provided significant control for diabetic nephropathy. Mechanistically, the significant improvement in BMZ with metformin in controlling retinopathy, nephropathy, and neuropathy are directly linked to (1) Increased glycemic control (antihyperglycemic effect), (2) increased insulin sensitivity as evidenced by reduced HOMA-IR levels, (3) reduced oxidative stress (4) increased antioxidant activity through increased glutathione levels and increased GSH/GSSG ratio, and (5) improved regulation of carbohydrate and lipid metabolism as evidenced by metabolomic data. This study provides robust and direct evidence to support the use of affordable, proven antioxidant and mineral combinations with metformin to reduce diabetes-related complications in aging.},
    author = {Ramya Kateel and Namita N. Kashyap and Shivakumar K. Reddy and Sahana Shetty and Meena K. Kumari and Sheetal D. Ullal and Sadhana N. Holla and Annayya Aroor and Michael A. Hill and Vijetha Shenoy Belle and Krishnananda Prabhu and Manjunath B. Joshi and Dinesh Upadhya},
    doi = {https://doi.org/10.1016/j.clnu.2025.05.004},
    issn = {0261-5614},
    journal = {Clinical Nutrition},
    keywords = {Diabetes mellitus, Aging, Metformin, β-carotene, Diabetic complications, Magnesium and zinc deficiency},
    pages = {183-197},
    title = {Chronic β-carotene, magnesium, and zinc supplementation together with metformin attenuates diabetes-related complications in aged rats},
    url = {https://www.sciencedirect.com/science/article/pii/S0261561425001323},
    volume = {50},
    year = {2025}
}

