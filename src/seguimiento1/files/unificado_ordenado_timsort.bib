    title = {Chapter 7 - Tools and platforms for prompt engineering},
    url = {https://www.sciencedirect.com/science/article/pii/B9780443339042000082},
    year = {2025}
}

@incollection{KNOLLE202583,
    abstract = {Federated learning has emerged as a pivotal technology in the healthcare sector, enabling collaborative model training, which allows for effective patient data governance. This approach, however, has proven to be insufficient in effectively protecting patient privacy. By way of this chapter, we delve into differential privacy, a robust solution to guarantee patient privacy in federated learning settings. Differential privacy offers a practical, general, and quantifiable framework for worst-case privacy protection, which is critical when handling sensitive patient data. By utilizing differential privacy in federated learning workflows, strong privacy guarantees can be achieved with often minimal compromises in the utility of shared insights or model performance. This chapter provides an in-depth introduction to how differential privacy can be operationalized by way of discussing its theoretical foundations, practical implementation strategies, and the inherent tradeoff between utility and privacy.},
    author = {Moritz Knolle and Georgios Kaissis},
    booktitle = {Federated Learning for Medical Imaging},
    doi = {https://doi.org/10.1016/B978-0-44-323641-9.00017-0},
    editor = {Xiaoxiao Li and Ziyue Xu and Huazhu Fu},
    isbn = {978-0-443-23641-9},
    keywords = {collaborative model training, protecting patient privacy, differential privacy, informational self-determination, model weights, privacy-utility tradeoff, postprocessing theorem, postprocessing resilience},
