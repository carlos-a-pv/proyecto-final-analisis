@article{MANJUNATHACHAR2024100689,
    abstract = {Leptospirosis, an underdiagnosed zoonotic disease in India, was studied retrospectively in Madhya Pradesh, Central India. Between 2018 and 2019, 2617 samples from patients with hepatitis-related symptoms were collected. Of these, 518 tested negative for hepatitis and other tropical viral diseases under the VRDL project were analyzed for leptospira IgM using ELISA. 68 (13.12%) were positive for leptospirosis. Common symptoms included fever (97.45%) and jaundice (42.27%), with renal involvement in 30.88% of cases. Higher incidence was observed in the 31–60 age group, especially during monsoon and post-monsoon seasons. The study highlights the need for increased clinician awareness and inclusion of leptospirosis in screening panels to differentiate tropical illnesses in India.},
    author = {H.V. Manjunathachar and Pradip V. Barde and Vivek Chouksey and Prakash Tiwari and Basavaraj Mathapati and Suyesh Shrivastava and Tapas Chakma},
    doi = {https://doi.org/10.1016/j.ijmmb.2024.100689},
    issn = {0255-0857},
    journal = {Indian Journal of Medical Microbiology},
    keywords = {Leptospirosis, Central India, Zoonoses},
    pages = {100689},
    title = {Leptospirosis in central India: A retrospective study to explore burden of tropical illness},
    url = {https://www.sciencedirect.com/science/article/pii/S0255085724001646},
    volume = {51},
    year = {2024}
}

