@article{HE2025139518,
    abstract = {The damage to asphalt mixture caused by freeze-thaw cycles significantly affects its mechanical performance. This has been verified by the experiment. However, the damage evolution mechanism of asphalt mixture under the influence of repeated freeze-thaw cycles is still unclear. In light of this, this paper employs micro-scale numerical simulation and experimental methods to study the freeze-thaw damage mechanism of asphalt mixture. A beam specimen was utilized to measure the frost heave strain. The volume change of air voids caused by repeated freezing and thawing was described through the equivalent expansion coefficient, which was derived based on the content of air voids. A FE meso model of asphalt mixture was reconstructed using CT scanning technology and image processing technique. The internal damage evolution laws and mechanical properties of asphalt mixture were analyzed through FE simulation. Results indicate that with the increase in freeze-thaw cycles, the moisture absorption of asphalt mixture continuously increases, gradually stabilizing after 7 cycles. The frost heave strain increases rapidly in the early stage of freeze-thaw cycling, and gradually slows down in the later stage. The proposed equivalent expansive coefficient effectively characterizes the internal damage of asphalt mixture under repeated freeze-thaw cycles. Under the action of freeze-thaw cycles, the mortar around the void cracks first. As the cycles increase, adjacent voids gradually connect, and the damaged area of the mixture further expands. Both numerical results and the measured results indicate that the strength of asphalt mixture is more susceptible to freeze-thaw cycles than the modulus. The freeze-thaw cycles lead to a reduction in the fracture threshold of asphalt mixture. The proposed method based on equivalent expansive coefficient is reasonable and feasible, with certain applicability and universality to other porous materials.},
    author = {Wenli He and Lili Li and Feifei Lv and Qinglin Guo and Li Zhang and Zhiyong Liu and Yiming Li and Keyi Wang},
    doi = {https://doi.org/10.1016/j.conbuildmat.2024.139518},
    issn = {0950-0618},
    journal = {Construction and Building Materials},
    keywords = {Asphalt mixture, Frost damage, Equivalent expansive coefficient, Freeze-thaw cycles, Mesoscopic simulation},
    pages = {139518},
    title = {Repeated freeze-thaw damage mechanism of asphalt mixture based on equivalent expansive coefficient of air void from mesoscopic perspective},
    url = {https://www.sciencedirect.com/science/article/pii/S0950061824046609},
    volume = {458},
    year = {2025}
}

