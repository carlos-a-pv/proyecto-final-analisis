    journal = {Heliyon},
    keywords = {EthR inhibitors, Machine learning, Artificial intelligence, Mycobacteria, Anti-TB drugs},
    number = {4},
    pages = {e42593},
    title = {Generative AI, molecular docking and molecular dynamics simulations assisted identification of novel transcriptional repressor EthR inhibitors to target Mycobacterium tuberculosis},
