@article{FONTOURA2025102847,
    abstract = {Considering the mounting request for viable energy solutions emphasising sustainability, this study addresses the context by positioning Generative Artificial Intelligence (Gen-AI) as a pivotal remedy for improved process efficiency. Concerns about its uncontrolled use and ethical implications prompted a thorough examination of problems and gaps in this domain. This study innovates by positioning Gen-AI as a critical solution for improving energy efficiency amidst rising demand for sustainable energy at the operation and supply chain management levels. Based on technological determinism, it introduces an Energy Gen-AI Technology Framework (EnGen-AI) that integrates Gen-AI, energy efficiency, Business Ethics (BE), and Corporate Social Responsibility (CSR) principles for implementing Gen-AI to enhance sustainable energy management. The methodology includes a scoping review, a multi-criteria analysis, and a technology framework. The study harmonises BE-CSR with Gen-AI practices, offering essential guidance for management implementing Gen-AI in sustainable energy solutions whilst observing its impacts on ethical and social aspects.},
    author = {Leonardo Fontoura and Daniel {Luiz de Mattos Nascimento} and Julio Vieira Neto and Rodrigo Goyannes {Gusmão Caiado}},
    doi = {https://doi.org/10.1016/j.techsoc.2025.102847},
    issn = {0160-791X},
    journal = {Technology in Society},
    keywords = {Generative artificial intelligence, Energy efficiency, Industry 4.0, Corporate social responsibility, Business ethics, Fuzzy DEMATEL},
    pages = {102847},
    title = {Energy Gen-AI technology framework: A perspective of energy efficiency and business ethics in operation management},
    url = {https://www.sciencedirect.com/science/article/pii/S0160791X25000375},
    volume = {81},
    year = {2025}
}

@article{KHADIDOS2025864,
    abstract = {In recent times, the growth in compact and inexpensive unmanned aerial vehicles (UAVs) and lightweight imaging sensors has led to an interest in utilizing them in different remote sensing applications. In UAV aerial imagery, acquiring meaningful image representations plays a crucial role in scene classification. Prior techniques to the scene classification procedure rely on feature coding techniques with lower-level unsupervised feature learning or hand-engineered features. As the number of UAVs improves, clustering is important and required to give scalability because clustering systems guarantee the primary level of system performance like energy efficiency (EE). Recently, deep learning (DL) has depended on methods that is used for scene classification models captured by UAVs. In this manuscript, an Energy-Aware Unmanned Aerial Vehicle-Assisted Mobile Multimedia Communication via Metaheuristic Optimization (EAUAV-MCMO) technique is proposed. The major intention of the EAUAV-MCMO technique is to present an effective model for energy-aware dynamic resource allocation in UAV networks using advanced techniques. Initially, the chimp optimization algorithm (ChOA) model is used for clustering process which comprises five cluster fitness functions (FF) such as intra-cluster distance, UAV nodes, cluster node (CN) density, distance from CHs to sink, and EE. For scene classification, the VGG16 technique is employed for feature extraction. Furthermore, the stacked denoising auto-encoder (SDAE) technique is implemented for classification. Finally, the slime mold algorithm (SMA) adjusts the parameter tuning of the SDAE technique and results in superior classification results. The efficacy of the EAUAV-MCMO approach is examined under the UC Merced Land Use dataset. The comparison study of the EAUAV-MCMO approach illustrated a superior accuracy value of 99.37 % over existing methods.},
    author = {Adil O. Khadidos},
    doi = {https://doi.org/10.1016/j.aej.2025.08.003},
    issn = {1110-0168},
    journal = {Alexandria Engineering Journal},
    keywords = {Unmanned Aerial Vehicle, Energy-Aware, Mobile Multimedia Communication, Scene classification, Deep learning, Slime mold algorithm},
    pages = {864-876},
    title = {Energy-Aware Unmanned Aerial Vehicle-Assisted Mobile Multimedia Communication via Metaheuristic Optimization with Stacked Deep Learning Models},
    url = {https://www.sciencedirect.com/science/article/pii/S1110016825008737},
    volume = {129},
    year = {2025}
}

