}

@incollection{BAKERGARDNER2025332,
    abstract = {Librarianship in the Anglophone Caribbean dates back to the coming of the Europeans in the 15th century. Today, there is a vibrant library sector which provides services through public, national, school, special, academic and theological libraries. Through its three library training institutions, the region provides education in librarianship from the paraprofessional up to the doctoral level, and these Library and Information Science (LIS) workers are able to provide up to date services by leveraging the latest technologies. The region faces many natural disasters such as hurricanes and earthquakes and other challenges to information service delivery including poor perception of LIS work, and institutions, and limited funding. Despite these, networking and a desire to offer the best services to clients have enabled librarianship to survive and thrive in the region.},
    address = {Oxford},
