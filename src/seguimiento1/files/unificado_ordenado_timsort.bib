@article{MADRIDGARCIA2025228,
    abstract = {ABSTRACT
Objectives
Timely access to current rheumatology guidelines at the point of care is challenging. We aimed to develop and evaluate the first retrieval-augmented generation (RAG) system designed for adult rheumatology, integrating European Alliance of Associations for Rheumatology (EULAR) and American College of Rheumatology (ACR) guidelines to provide rheumatologists with timely evidence-based recommendations.
Methods
EULAR and ACR management guidelines were selected by rheumatologists based on their clinical relevance for decision-making and processed. A RAG system was implemented. To evaluate it, 10 questions per guideline were generated using ChatGPT 4.5. Answers to these were produced by ChatGPT-o3-mini with context retrieval (RAG) and without (baseline). Performance was assessed by an Large language model (LLM)-as-a-judge (Gemini 2.0 Flash) using a 5-point Likert scale across 5 dimensions: relevance, factual accuracy, safety, completeness, and conciseness; it also determined preference between the RAG and baseline responses. For validation, 2 rheumatologists independently evaluated a random sample of questions (15%) on the same domains. Statistical significance was established using the Wilcoxon signed-rank and binomial tests.
Results
Seventy-four guidelines were included, yielding 740 evaluation questions. The LLM-as-a-judge evaluation showed the RAG system significantly outperformed the baseline across all criteria (P < .001). Manual evaluation confirmed these findings (P < .001) for accuracy, safety, and completeness. The RAG system was significantly preferred by the LLM-as-a-judge in 92.8% of comparisons and by the human evaluators in 71.2% to 74.8% (P < .001).
Conclusions
Developing a RAG system integrating extensive EULAR/ACR rheumatology guidelines improves answer quality compared to a baseline LLM. This evaluation provides a robust foundation for reliable, artificial intelligence-driven clinical decision support tools designed to enhance evidence-based practice by providing clinicians with rapid, context-aware access to recommendations.},
    author = {Alfredo Madrid-García and Diego Benavent and Chamaida Plasencia-Rodríguez and Zulema Rosales-Rosado and Beatriz Merino-Barbancho and Dalifer Freites-Núñez},
    doi = {https://doi.org/10.1016/j.ero.2025.08.001},
    issn = {3050-7081},
    journal = {EULAR Rheumatology Open},
    number = {3},
    pages = {228-236},
    title = {Optimising the clinical application of rheumatology guidelines using large language models: a retrieval-augmented generation framework integrating EULAR and ACR recommendations},
    url = {https://www.sciencedirect.com/science/article/pii/S3050708125000631},
    volume = {1},
    year = {2025}
}

@article{ZHU2025345,
    abstract = {In urban landscape design, the optimization of spatial layout is very important because it directly affects the functionality, ecological benefits and aesthetic effects of the landscape. This paper introduces a generative algorithm to optimize the layout of garden space elements. It aims to improve the rationality, aesthetics and functionality of the layout scheme through automation and intelligence, so as to better adapt to different environments and user needs. First, a geometric model of the urban landscape space is constructed, and the functional areas, green spaces, water bodies and other elements of the garden are converted into design constraints and objective functions suitable for generative algorithm processing. Then, using genetic algorithm as an optimization tool, through the iterative evolution process of the population, the position, form and combination of spatial elements are gradually adjusted to achieve the predetermined design goals. Finally, the fitness function is introduced to evaluate the pros and cons of each generation of layout schemes, including the openness of the landscape view, the coherence of the functional areas and the aesthetic evaluation. Through multiple iterations, the algorithm gradually converges to the optimal solution and provides a garden layout scheme that meets specific needs. In the layout optimization under complex terrain, the space utilization rate is between 75.0% and 77.8%. The landscape view is distributed between 66.3% and 68.0%, which is relatively evenly distributed. The urban landscape garden space element layout optimization method based on the generative algorithm introduced in this paper not only improves the design efficiency and accuracy but also provides new ideas for urban garden planning.},
    author = {Di Zhu},
    doi = {https://doi.org/10.1016/j.procs.2025.04.213},
    issn = {1877-0509},
    journal = {Procedia Computer Science},
    keywords = {Generative Algorithm, Urban Landscape Architecture, Spatial Element Layout Optimization, Landscape Vision},
    note = {The 5th International Conference on Machine Learning and Big Data Analytics for IoT Security and Privacy (SPIoT2024)},
    pages = {345-353},
    title = {Optimization Method for Spatial Element Layout of Urban Landscape Architecture Based on Generative Algorithm},
    url = {https://www.sciencedirect.com/science/article/pii/S1877050925013158},
    volume = {261},
    year = {2025}
}

@article{WANG2025990,
    abstract = {Aiming at the problems of inefficiency, information disjunction and lack of innovation in traditional architectural design schemes, this paper proposes an intelligent evaluation model combining grey correlation analysis, radial basis function neural network and ant colony algorithm. By constructing multi-dimensional building performance index system, combining data dimensionality reduction and nonlinear mapping technology, the problem of index homogeneity and parameter convergence in traditional evaluation is solved. Through experiments, it is found that the average evaluation accuracy of ACO-RBF and GRA-RBF models is 87.48% and 86.60% respectively, while the fusion model in this paper achieves a performance improvement with an accuracy of 93.31%. The model adopts a three-stage collaborative mechanism -- feature space reconstruction, parameter global optimization and nonlinear decision mapping. It significantly improves the objectivity and reliability of complex building performance evaluation, provides a verifiable technical framework for intelligence-driven design decisions, and promotes the transformation of architectural design scheme evaluation from an experience-dependent paradigm to a data-driven paradigm.},
    author = {Xin Wang and Tingting Yang},
    doi = {https://doi.org/10.1016/j.procs.2025.04.491},
    issn = {1877-0509},
