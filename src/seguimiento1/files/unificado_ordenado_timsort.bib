    keywords = {Boron-doped diamond, Microscale electrodes, Structurization, Electrochemistry, Posaconazole detection},
    pages = {126519},
    title = {Optimizing Ni–Cr patterned boron-doped diamond band electrodes: Doping effects on electrochemical efficiency and posaconazole sensing performance},
    url = {https://www.sciencedirect.com/science/article/pii/S0039914024008981},
    volume = {278},
