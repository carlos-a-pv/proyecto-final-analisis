    keywords = {metadata, health services research, audit logs, event logs, electronic health record data, health care delivery, patient care, healthcare teams, clinician-patient relationship, cognitive environment},
    title = {Emerging Domains for Measuring Health Care Delivery With Electronic Health Record Metadata},
    url = {https://www.sciencedirect.com/science/article/pii/S1438887125003310},
    volume = {27},
    year = {2025}
}

@article{SRIVASTAVA2025103128,
    abstract = {Since the publication of the first papers in the early 1990s, molecular simulation as a reliable biophysical tool in the area of membrane biophysics has come a long way. Advances in simulation algorithms, coupled with exascale computing have pushed the size and time scales of biomolecular membrane simulations to scales where connections to experiments are made with higher fidelity. When integrated with experimental data in a theoretically well-grounded manner, current biomolecular simulations are providing indispensable insights that cannot be obtained through experiments alone. Here, I summarize some recent developments where simulations have allowed a deeper understanding in membrane spatiotemporal organization. I also discuss the need for transformative method developments to meet recent breakthroughs in experimental measurements at molecular scales.},
    author = {Anand Srivastava},
    doi = {https://doi.org/10.1016/j.sbi.2025.103128},
    issn = {0959-440X},
    journal = {Current Opinion in Structural Biology},
    pages = {103128},
    title = {Emerging paradigms in the lateral and transverse organization in biological membrane and their functional implications: Connecting the dots with biomolecular simulations},
    url = {https://www.sciencedirect.com/science/article/pii/S0959440X25001460},
    volume = {94},
    year = {2025}
}

@article{ETON2025100190,
    abstract = {Objective
This article reviews the cellular and rheologic mechanisms of neovascularization (NV) and fibrinolysis in chronic ischemia. These mechanisms provide an explanation for the proteomic and cytometry data obtained from patients with chronic limb-threatening ischemia (CLTI) who were successfully treated with granulocyte colony-stimulating factor (G-CSF).
Rationale
G-CSF was used in CLTI to promote NV by progenitor cell mobilization. This review was prompted by the significant G-CSF-induced neutrophilia after each G-CSF administration. Neutrophils had been considered antiangiogenic and prothrombotic. However, angiographic evidence of arteriogenesis and fibrinolysis was observed in patients with CLTI treated with a novel G-CSF regimen (filgrastim 7-10 μg/kg every 72 hours for up to 10 doses). Enzyme-linked immunosorbent assays identified significant (P < .01) elevation of the concentration proangiogenic serum proteins and of plasmin (>10-fold) and fibrin degradation products (>5-fold) in plasma. Levels peaked one day after each G-CSF dose, as did the absolute neutrophil count. Levels decreased toward baseline before the next dose, in conjunction with the absolute neutrophil count. No hemorrhage occurred during the month of G-CSF treatment.
Methods
Multi-disciplinary literature review facilitated by artificial intelligence.
Results
Evidence has emerged regarding the context-dependent role of neutrophils in modulating both angiogenesis and fibrinolysis. The proangiogenic impact of activated neutrophils includes the release of hepatocyte growth factor, vascular endothelial growth factor A, matrix metalloproteinase-9, and angiopoietin 1. The increase in these same proteins 24 hours after G-CSF administration in the CLTI population treated above may thus be attributable to neutrophilia. Moreover, neutrophils secrete proteases that degrade thrombus and have context-dependent fibrinolytic capacity.
Conclusions
Induced neutrophilia can promote a proangiogenic and profibrinolytic environment in the specific context of chronically ischemic tissue. This article was prepared to facilitate further research into this potential transformative medical treatment for CLTI, with benefit potential in other chronically ischemic beds.},
    author = {Darwin Eton},
    doi = {https://doi.org/10.1016/j.jvsvi.2025.100190},
    issn = {2949-9127},
    journal = {JVS-Vascular Insights},
    keywords = {Neutrophilia, Neutrophil, Angiogenesis, Arteriogenesis, Filgrastim, Neupogen, Granulocyte-colony stimulating factor, G-CSF, Fibrinolysis, Thrombosis, Nitric oxide synthase, Neovascularization, Plasmin, Hepatocyte growth factor, VEGF, Artassist device, Ischemia, Vascular disease, VEGF-165b, MMP-9, Hematopoietic stem and progenitor cell, Endothelial progenitor cell, Hematopoietic stem cell, Hematopoietic progenitor cell},
    pages = {100190},
    title = {Emerging path promoting neovascularization in chronic ischemia},
    url = {https://www.sciencedirect.com/science/article/pii/S2949912725000078},
    volume = {3},
    year = {2025}
}

