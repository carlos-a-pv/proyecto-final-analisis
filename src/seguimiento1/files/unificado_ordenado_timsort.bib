    edition = {First Edition},
    editor = {David Baker and Lucy Ellis},
    isbn = {978-0-323-95690-1},
    keywords = {ACURIL, CARALL, Caribbean, CARICOM, COLINET, COSTAATT, Covid-19, DLOC, LATT, LIAJA, NALIS, National libraries, Prison libraries, Public libraries, School libraries, Special l libraries, Theological libraries, University of the West Indies, West Indies},
    pages = {332-342},
    publisher = {Academic Press},
