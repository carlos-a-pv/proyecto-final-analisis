@article{GONCALVES2025685,
    abstract = {Batteries play a crucial role in the transition to sustainable energy systems. Optimizing battery design for material and energy efficiency, durability, and recyclability is key to developing more sustainable solutions to support this change. This article outlines the process of creating a more efficient battery pack by focusing on improving material and energy use during production and end-of-life, through a Lean-based tool. The aim is to reduce impacts across the battery pack’s lifecycle, following the eco-design practices and standards by enhancing the durability of materials and components and simplifying their recovery and recycling. The improvements are being carried out within the scope of a European Project, which aims to enhance the durability of materials and components and make it easier to recover and recycle them. The Lean Design-for-eXcellence methodology was used to identify areas for potential improvement in the pack’s design, namely considering Design-for-Manufacturing, Design-for-Second Life, and Design-for-Recyclability. The results show potential opportunities to improve the efficiency of control, safety, mechanical, and electrical systems across different domains. Key areas for improvement that could significantly enhance overall system sustainability performance include reducing weight, optimizing coolant flow, and expediting disassembly and assembly processes.},
    author = {Rafaela Gonçalves and Maria Inês Soares and Mohammad Hossein {Morshed Varzandeh} and Qing Chen and Emanuel Lourenço},
    doi = {https://doi.org/10.1016/j.procir.2025.01.068},
    issn = {2212-8271},
    journal = {Procedia CIRP},
    keywords = {Sustainable battery design, Lean Design-for-Excellence, Manufacturing, Second Life, Recyclability},
    note = {32nd CIRP Conference on Life Cycle Engineering (LCE2025)},
    pages = {685-690},
    title = {Sustainable battery design: Lean design for excellence as an enabler},
    url = {https://www.sciencedirect.com/science/article/pii/S2212827125003385},
    volume = {135},
    year = {2025}
}

@article{COELHO2025100182,
    abstract = {The pop music market is, currently, a multi-million dollars business, with a considerable environmental footprint. This industry is increasingly concerned about its environmental, economic and social impact, and it is convinced that it can become a huge hub for the promotion of the Sustainable Development Goals (SDGs). That is why we are assisting to an interesting movement of social responsibility into this industry. This research addresses the main sources of sustainable benefits of this activity. It investigates who are the stakeholders involved, and the modes of acting that reveal socially responsible positioning, its potentialities and limits, focusing on the live music segment of this business. It is concluded that, despite an interesting path already taken in these dimensions of social responsibility, the results are still insufficient and there is room for new initiatives.},
