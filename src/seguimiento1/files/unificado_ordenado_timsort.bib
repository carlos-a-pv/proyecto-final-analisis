}

@article{KUMAR2025112768,
    abstract = {Lattice structures are known for their lightweight nature, excellent energy absorption, and superior thermal and acoustic insulation properties, making them ideal for applications in safety, aerospace, heat dissipation systems, and biomedical devices. With the advent of additive manufacturing, particularly laser powder bed fusion (PBF-LB), the fabrication of complex lattice geometries with high precision has become feasible, which requires further investigation of their surface characteristics, microstructural behaviour, mechanical characteristics under different loading conditions, and biocompatibility. Therefore, this study was conducted to comprehensively analyze the surface integrity, mechanical responses, and biocompatibility of six distinct cellular architectures based on strut-based and sheet-based triply periodic minimal surface (TPMS) topologies. The structures were designed using 3D Xpert software and manufactured using biomedical grade 316 L stainless steel (316 L SS) powder through the PBF-LB process. The dimensional analysis and surface roughness values indicated that the sheet-based structure demonstrated the closest alignment with its designed value. The XRD patterns and microstructural analysis have presented a marginal difference in the peak intensity and grain morphologies of the strut-based and sheet-based structures. Key mechanical properties, including compressive and tensile strength, high-cycle fatigue, and deformation behaviour, were systematically evaluated to compare the performance of these cellular designs. Relative density emerged as a crucial factor influencing the lattices' mechanical properties. In tensile testing, TPMS architectures outperformed strut-based counterparts in both strength and ductility. Among the strut-based lattices, the dodecahedron structure exhibited the highest ultimate tensile strength (UTS) at 83.92 MPa, while the split-p lattice from the TPMS category achieved a UTS of 307.34 MPa. The dodecahedron and split-p lattices also demonstrated exceptional resistance to both tensile and compressive loads, making them promising candidates for further study. Furthermore, the high-cycle fatigue tests revealed that the split-p lattice significantly outlasted the dodecahedron structure, enduring 317,010 cycles before failure at 0.2 σy and 48,730 cycles at 0.8 σy. Finally, the cell viability assessment showed that the dodecahedron lattice demonstrated the highest viability in the strut-based group, while the gyroid structure led among the sheet-based configurations. The findings of this study provide valuable insights into the mechanical performance of strut and TPMS cellular architectures, highlighting their potential for optimization in biomedical applications where strength, durability, and weight reduction are critical.},
    author = {Deepak Kumar and Suryank Dwivedi and Ashish Kumar Srivastava and Amit Rai Dixit},
    doi = {https://doi.org/10.1016/j.mtcomm.2025.112768},
    issn = {2352-4928},
    journal = {Materials Today Communications},
    keywords = {Metal Additive Manufacturing, Laser Powder Bed Fusion, 316 L Stainless Steel, Strut Lattice, TPMS, Mechanical Behavior, High-cycle Fatigue},
    pages = {112768},
    title = {Comprehensive study on mechanical response of strut-based and sheet-based 316 L stainless steel cellular architectures for biomedical application through laser powder bed fusion},
    url = {https://www.sciencedirect.com/science/article/pii/S2352492825012802},
    volume = {46},
    year = {2025}
}

@article{ZHENG2025113524,
    abstract = {In recent years, intelligent decision making has become a national strategic level to attach great importance to the focus of the fields, in medicine, business, manufacturing, agriculture, etc. Exemplified by breakthroughs such as GPT-4, LLaMA, Deepseek, and multimodal systems like AlphaFold, large models have catalyzed a paradigm shift in artificial intelligence—from perceptual tasks to complex decision-making scenarios. This paper presents a comprehensive survey on large models (LMs)-driving intelligent decision making, where the main contributions are as follows: 1) innovatively give a definition of LM-driving intelligent decision making, and establish a novel multi-role functional framework distinguishing LMs as data synthesizers (preparers), contextual reasoners (facilitators), and ethical validators (reflectors). 2) cross-disciplinary bibliometric analysis reveals the current research landscape in this field, demonstrating a wide range of interests within the community. 3) conduct a profound and comprehensive analysis of key components and applications of LMs-driving intelligent decision making, and deeply analyze the advantages, limitations, and challenges associated with this approach while also suggesting future research directions. Furthermore, we recommend three priority research directions: 1) Develop reasoning-enhanced LMs overcoming parameter limits via non-parametric activation. 2) Create interpretable LMs mirroring human decision processes (intuition vs. systematic thought) through problem-solving transparency. 3) Combine fuzzy/probabilistic methods with Transformers for real-world adaptability and adaptive evaluation frameworks. This work advances both theoretical understanding through its interdisciplinary perspective and offers concrete implementation blueprints for industry practitioners navigating LM adoption in decision-critical contexts.},
    author = {Yuanhang Zheng and Tong Wu and Xiangyu Xiao and Zeshui Xu},
    doi = {https://doi.org/10.1016/j.asoc.2025.113524},
    issn = {1568-4946},
    journal = {Applied Soft Computing},
    keywords = {Intelligent decision making, Large models, Survey, Interaction, Multi-modal information, Interpretability},
    pages = {113524},
    title = {Comprehensive survey of large models-driving intelligent decision making},
    url = {https://www.sciencedirect.com/science/article/pii/S156849462500835X},
    volume = {181},
    year = {2025}
}

@article{DUAN2025489,
    abstract = {Summary
Broadly neutralizing antibodies (nAbs) are vital therapeutic tools to counteract both pandemic and seasonal influenza threats. Traditional strategies for optimizing nAbs generally rely on labor-intensive, high-throughput mutagenesis screens. Here, we present an innovative structure-based design framework for the optimization of nAbs, which integrates epitope-paratope analysis, computational modeling, and rational design approaches, complemented by comprehensive experimental assessment. This approach was applied to optimize MEDI8852, a nAb targeting the stalk region of influenza A virus hemagglutinin (HA). The resulting variant, M18.1.2.2, shows a marked enhancement in both affinity and neutralizing efficacy, as demonstrated both in vitro and in vivo. Computational modeling reveals that this improvement can be attributed to the fine-tuning of interactions between the antibody’s side-chains and the epitope residues that are highly conserved across the influenza A virus HA stalk. Our dry-wet iterative protocol for nAb optimization presented here yielded a promising candidate for influenza intervention.},
    author = {Huarui Duan and Xiaojing Chi and Xuehua Yang and Shengnan Pan and Xiuying Liu and Peixiang Gao and Fangyuan Zhang and Xinhui Zhang and Xuemeng Dong and Yi Liao and Wei Yang},
    doi = {https://doi.org/10.1016/j.str.2025.01.002},
    issn = {0969-2126},
    journal = {Structure},
    keywords = {computational biology, RosettaAntibodyDesign, influenza A virus, hemagglutinin, neutralizing antibody},
    number = {3},
    pages = {489-503.e5},
    title = {Computational design and improvement of a broad influenza virus HA stem targeting antibody},
    url = {https://www.sciencedirect.com/science/article/pii/S0969212625000024},
    volume = {33},
    year = {2025}
}

@article{LIU2025104337,
    abstract = {We present a computational framework for designing Multi-layered Wood Carving Artwork (MWCA), where intricately carved, colored wooden layers are stacked to create visually striking compositions. Each laser-cut layer must preserve global connectivity and minimize fine branching to maintain structural integrity. Traditionally reliant on artisanal trial-and-error, MWCA design has been time-consuming and labor-intensive. Our method is driven by a key observation: during connectivity analysis, the region of an upper layer can be treated as part of the lower layers. Leveraging this insight, we develop an iterative greedy algorithm to jointly determine the color assignment and geometric shape of each layer. To facilitate processing, we perform an image pre-processing step that reduces the input to a limited color palette. Additionally, a post-processing step is incorporated to enhance the structural integrity of the final output. We demonstrate the effectiveness and practical viability of our approach through 18 examples, including 3 fabrication results.},
    author = {Haochen Liu and Zhi Li and Kang Wu and Youcheng Cai and Xiaoya Zhai and Ketian Zhang and Ligang Liu and Yi Min Xie and Xiao-Ming Fu},
    doi = {https://doi.org/10.1016/j.cag.2025.104337},
    issn = {0097-8493},
    journal = {Computers & Graphics},
    keywords = {Computational design, Laser cutting, Wooden artworks, Path generation, Image vectorization, Personalized fabrication},
    pages = {104337},
    title = {Computational multi-layered wood carving art},
    url = {https://www.sciencedirect.com/science/article/pii/S0097849325001785},
    volume = {131},
    year = {2025}
}

@article{LI2025115329,
    abstract = {This study examines how computer vision transforms branding research by offering a typology of visual features and introducing an integrative CTV-CBBE framework that bridges computational processes and branding outcomes. Through an integrative literature review, we analyze the impact of computer vision across different levels of brand equity, highlighting a progression from single-level to integrative visual analysis, from single to multimodal approaches, and from static imagery to broader visuals. These advancements underscore the growing importance of computer vision in navigating dynamic, hyperconnected branding environments. Our findings contribute to assessing brand identity, enhancing product design, interpreting brand meaning, evaluating consumer sentiment, and improving engagement. To advance the field, we propose a future research agenda centered on leveraging underexplored visual features, generative artificial intelligence, and multimodality while aligning technical innovations with branding theories. This study offers a strategic roadmap for researchers and practitioners to harness computer vision to enhance branding strategies.},
    author = {Yaqiu Li and Hsin Hsuan {Meg Lee} and Lorena Blasco-Arcas},
    doi = {https://doi.org/10.1016/j.jbusres.2025.115329},
    issn = {0148-2963},
    journal = {Journal of Business Research},
    keywords = {Branding, Computer vision, Machine learning, Image analysis, Visual analysis, Deep learning},
    pages = {115329},
    title = {Computer vision in branding: A conceptual framework and future research agenda},
    url = {https://www.sciencedirect.com/science/article/pii/S0148296325001523},
    volume = {193},
    year = {2025}
}

@article{YU2025119262,
    abstract = {A residual capability intelligent detection method based on computer vision is proposed to address the issues of low efficiency, poor accuracy, and high danger in manual measurement of energy dissipators in flexible protection systems. The proposed method first establishes a binary semantic segmentation dataset for energy dissipators and trains a salient object detection deep neural network to segment the energy dissipator binary map; Then, it uses morphological image processing and contour detection to calculate the residual capability automatically. U2-Net, U2-Netp, and BASENet were trained and compared by a dataset with 500 ring-type energy dissipator images. The proposed method was validated through a quasi-static tensile test and a full-scale impact test. Compared with the most accurate integration calculation method, the error of the proposed method does not exceed 3 %, and the efficiency is improved by about 25 times compared to the most commonly used manual detection method.},
    author = {Zhixiang Yu and Linxu Liao and Yuntao Jin and Lijun Zhang and Yongdin Tian and Wenjie Liao},
    doi = {https://doi.org/10.1016/j.engstruct.2024.119262},
    issn = {0141-0296},
    journal = {Engineering Structures},
    keywords = {Energy dissipator, Residual capability, Intelligent detection method, Flexible protection system, Computer vision, Salient object detection},
    pages = {119262},
    title = {Computer vision-based intelligent detection method for the residual capability of energy dissipators in flexible protection systems},
    url = {https://www.sciencedirect.com/science/article/pii/S0141029624018248},
    volume = {323},
    year = {2025}
}

@article{ALCAIDEMARZAL2025104168,
    abstract = {This preliminary research presents a comparative study between Text-to-Image AI models and Shape Grammars, one of the main generative approaches to Computer Aided Conceptual Design. The goal is to determine to which extent AI models can reproduce or complement the performance of grammar algorithms as creative support tools for shape exploration in conceptual product design. Workflows, advantages and limitations are identified through a comprehensive practical comparison example. The results show many similarities regarding generative capabilities and highlight several advantages of Text-to-Image AI models, including an easier way of capturing product grammars and a wider and more immediate range of further applications. In contrast, Shape Grammars approach proved more solid in aspects related to exploration workflows and cognitive stimulation. These results encourage the research on new ways to address the interaction between designers and AI generative models, combining the AI potential with well-established generative strategies.},
    author = {Jorge Alcaide-Marzal and Jose Antonio Diego-Mas},
    doi = {https://doi.org/10.1016/j.compind.2024.104168},
    issn = {0166-3615},
    journal = {Computers in Industry},
    keywords = {Computer Aided Conceptual Design, Artificial intelligence models, Computational creativity, Human-Computer Interaction, Product Design},
    pages = {104168},
    title = {Computers as co-creative assistants. A comparative study on the use of text-to-image AI models for computer aided conceptual design},
    url = {https://www.sciencedirect.com/science/article/pii/S0166361524000964},
    volume = {164},
    year = {2025}
}

@article{AGBO2025100266,
    abstract = {Recent advances in generative artificial intelligence (GenAI) are revolutionizing computing education, causing paradigm shifts from the traditional teaching and learning technique. Studies are exploring GenAI tools in computing classes from intro to advanced topics with the aim to showcase how to reshape computing education in this new era of GenAI. This study examined the computing education research landscape to unravel how GenAI tools have been used in that domain, what are the characteristics of those studies in terms of computing topics, context, and tools, offering insights into the pros and cons for integrating GenAI in computing education based on the performance indicators reported in the literature. This study employed a systematic literature review approach to identify and analyze 78 relevant articles. The findings of this study show that educators are exploring GenAI tools in computer sciences classes from K-12 through graduate levels. Beyond programming education, GenAI has also been explored in college upper-level computer science courses such as Computer Graphics and Human-Computer Interaction. The performance analysis of these tools are presented in this study, indicating a progressive advancement from when the technology was introduced. This study also discusses learning outcomes, good practices, and potential risks to avoid when exploring GenAI, as reported in the studies, which could guide how computing educators design their instructional strategies using GenAI. This study contributes to broadening the understanding of exploring, adapting, or using GenAI in computer science education and may spark interest among educators who are unwilling to explore GenAI or may not understand how or what strategies to adopt.},
    author = {Friday Joseph Agbo and Chris Olivia and Godsalvation Oguibe and Ismaila Temitayo Sanusi and Godwin Sani},
    doi = {https://doi.org/10.1016/j.caeo.2025.100266},
    issn = {2666-5573},
    journal = {Computers and Education Open},
    keywords = {Computing education, Programming, Generative artificial intelligence, Large language model},
    pages = {100266},
    title = {Computing education using generative artificial intelligence tools: A systematic literature review},
    url = {https://www.sciencedirect.com/science/article/pii/S2666557325000254},
    volume = {9},
    year = {2025}
}

