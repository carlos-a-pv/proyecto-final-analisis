@article{OLADIPO2025101894,
    abstract = {Background
YouTube is an accessible online resource for education-related information. An “intitle:” search modifier uses specific terms to aid in limiting or expanding results. There is limited knowledge on the impact of search modifiers on quality and accuracy of OB/GYN educational instructional videos.
Objective
Our objective is to examine the effect of “intitle:” search modifier on the quality and accuracy of YouTube OB/GYN educational videos.
Study Design
The American College of Obstetrics and Gynecology(ACOG) /The Council on Resident Education in Obstetrics and Gynecology (CREOG) endorsed the Surgical Curriculum of Obstetrics and Gynecology (SCOG) procedures. This approved procedure list in combination with the search modifier, “intitle:” was used in YouTube search queries. Results were screened with strict exclusion criteria and video characteristics were obtained. Videos were graded on accuracy and quality using a SCOG accuracy checklist and the validated Laparoscopic Surgery Video Educational Guidelines (LAP-VEGaS) video assessment tool. Results were analyzed using ANOVA statistical testing.
Results
A total of 353 videos were screened, 89 were excluded and 264 were analyzed. For videos without asearch modifier, international organizations had highest % accuracy and only international healthcare organization videos met a quality score of 11.2. After using a search modifier, average accuracy and quality scores increased by 33.2% and 38.1%, respectively. Videos with quality scores > 11 included multiple types of organizations (Table 6). The “intitle:” search modifier videos had statistically significant improvement in quality and accuracy separated by likes, views and affiliated organizations (p-value < 0.01). There were no statistically significant differences in accuracy and quality for the search modifier videos based on the number of subscribers and geographic location.
Conclusion
The user-friendly nature of YouTube allows OB/GYN providers the ability to access and learn from educational videos. Understanding characteristics associated with accurate and quality information ensures proper selection of precise and current educational resources. It is imperative that providers are aware of the importance and enhancement of “intitle:” search modifier when searching for OB/GYN educational content.},
    author = {Antonia F. OLADIPO and Dusan PERISIC and Emma R. HERRERO and Nicole ACERO and Kaitlyn VOITY and Juanita FONCHAM and Jamie MCILVAINE and Emre KAYAALP},
    doi = {https://doi.org/10.1016/j.cpsurg.2025.101894},
    issn = {0011-3840},
    journal = {Current Problems in Surgery},
    keywords = {Accuracy, Binary, Curriculum, Graduate Medical Education, Quality, Residency Training, Self-Directed Learning, Surgical, Undergraduate Medical Education},
    pages = {101894},
    title = {YouTube Search Optimization Using Title-Based Operators on OB/GYN Educational Video Quality},
    url = {https://www.sciencedirect.com/science/article/pii/S0011384025001777},
    year = {2025}
}

