@article{BATCHELLER2024543,
    abstract = {Nurse leaders can easily identify and discuss the challenges they face, which reassures them they are not alone. The real challenge for nurse leaders is to prioritize and spend time thinking about what is needed to meet future challenges. This kind of intentional thinking can occur using an “idealized design” technique. The limitations and baggage from prior experiences is left behind. A new framework can be used to help leaders work through the business of busyness. This includes the Three Rs™ Rethink, Reframe, and Relate.},
