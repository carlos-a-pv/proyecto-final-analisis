@article{ZENG2025109221,
    abstract = {Amid the global surge in generative AI and the resulting compute revolution, thermal management has emerged to be a pivotal determinant of its success. Innovation in thermal interface materials (TIMs) now represents a strategic frontier in shaping the trajectory of the Fourth Industrial Revolution. Conventional silicone-based TIMs face a performance dilemma comprising thermal cycling-induced interfacial delamination, aging-related increases in interfacial thermal resistance. Building on previous work that introduced poly(ionic liquid)s (PILs) as a novel alternative to silicones, this study further optimizes the molecular structure of PILs. Incorporation of ethoxy groups significantly enhances the mechanical compliance of PIL while maintaining high adhesion strength. Robust hydrogen bonding between ethoxy groups in PIL and liquid metal enables a high loading of 82 vol% without leakage, achieving a thermal conductivity of nearly 5 W m−1 K−1. Meanwhile, strong interfacial adhesion yields a interface contact thermal resistance of 0.74 ± 0.12 × 10-6 m2·K/W between the PIL/LM composite and Si, lower than that of silicone-based TIMs. The noncovalent self-healing of the PIL matrix effectively prevents crack formation in TIMs during aging. This work advances the application of PILs in TIMs and provides strategies for performance optimization, paving the way for their practical deployment as viable matrix alternatives.},
    author = {Jianhui Zeng and Taoying Rao and Ting Liang and Yimin Yao and Chaoyang Wang and Jian-Bin Xu and Liejun Li and Rong Sun},
    doi = {https://doi.org/10.1016/j.compositesa.2025.109221},
    issn = {1359-835X},
    journal = {Composites Part A: Applied Science and Manufacturing},
    keywords = {Thermal interface material, Polymer composite, Poly(ionic liquid), Liquid metal},
    pages = {109221},
    title = {Poly(Ionic Liquid) matrices embedded with liquid metal particles: A versatile solution for high-power density thermal management},
    url = {https://www.sciencedirect.com/science/article/pii/S1359835X25005159},
    volume = {199},
    year = {2025}
}

@article{YAN2025117950,
    abstract = {The trade-offs between different mechanical properties of materials pose fundamental challenges in engineering material design, such as balancing stiffness versus toughness, weight versus energy-absorbing capacity, and among the various elastic coefficients. Although gradient-based topology optimization approaches have been effective in finding specific designs and properties, they are not efficient tools for surveying the vast design space of metamaterials, and thus unable to reveal the attainable bound of interdependent material properties. Other common methods, such as parametric design or data-driven approaches, are limited by either the lack of diversity in geometry or the difficulty to extrapolate from known data, respectively. In this work, we formulate the simultaneous exploration of multiple competing material properties as a multi-objective optimization (MOO) problem and employ a neuroevolution algorithm to efficiently solve it. The Compositional Pattern-Producing Networks (CPPNs) is used as the generative model for unit cell designs, which provide very compact yet lossless encoding of geometry. A modified Neuroevolution of Augmenting Topologies (NEAT) algorithm is employed to evolve the CPPNs such that they create metamaterial designs on the Pareto front of the MOO problem, revealing empirical bounds of different combinations of elastic properties. Looking ahead, our method serves as a universal framework for the computational discovery of diverse metamaterials across a range of fields, including robotics, biomedicine, thermal engineering, and photonics.},
    author = {Maohua Yan and Ruicheng Wang and Ke Liu},
    doi = {https://doi.org/10.1016/j.cma.2025.117950},
    issn = {0045-7825},
    journal = {Computer Methods in Applied Mechanics and Engineering},
    keywords = {Metamaterials, Neuroevolution, Multi-objective optimization, Mechanical oroperties, Compositional pattern-producing networks (CPPNs)},
    pages = {117950},
    title = {Populating cellular metamaterials on the extrema of attainable elasticity through neuroevolution},
    url = {https://www.sciencedirect.com/science/article/pii/S0045782525002221},
    volume = {440},
    year = {2025}
}

@article{BIDDLE2025569,
    abstract = {Background:
Sarcoidosis is a systemic inflammatory condition characterised by the formation of granuloma in organs. It can cause end-organ damage and is associated with an elevated risk of mortality [1, 2]. Despite its clinical importance, the epidemiology of sarcoidosis in England is poorly characterised, with a notable lack of published data on its prevalence, and estimates of incidence and mortality that were last calculated two decades ago [3, 4].
Objectives:
This study's objective was to explore contemporary trends in the incidence, prevalence, and mortality rates of sarcoidosis in England.
Methods:
This research utilised a population-based approach, using data from the Clinical Practice Research Datalink (CPRD), linking primary care records with secondary care data and death registrations from the Office for National Statistics (ONS). Adults aged 18 years or older who contributed data between 2003 and 2023 were included. Sarcoidosis cases were identified through diagnostic codes in primary care records. Age- and sex-standardised incidence and prevalence were calculated. Standardised mortality ratios (SMRs) were used to compare mortality rates with those of the general population. A control cohort without sarcoidosis was matched within the CPRD, and negative binomial regression was applied to assess differences in all-cause mortality rates between individuals with incident sarcoidosis and their matched counterparts.
Results:
A total of 56,287 patients had a diagnostic code for sarcoidosis between January 1st, 2003 and December 31st 2023. The age and sex-standardised incidence of sarcoidosis was 6.65 per 100,000 person-years in 2003 and 7.73 per 100,000 person-years in 2023 (Figure 1a). Regression demonstrated an annual increase in incidence of 0.10 cases per 100,000 person-years (95% CI 0.06 to 0.14) over the study period. Notable rises in new diagnoses were observed among males and individuals over 60 years old. The prevalence of sarcoidosis using at least one diagnostic code, standardised by age and sex, increased from 168 per 100,000 in 2003 to 231 per 100,000 in 2023. This increase appeared consistent across the study period (Figure 1b). The age-and-sex-standardised all-cause mortality rate among the prevalent population was 9.5 per 1,000 patients in 2003 and 12.2 per 1,000 patients in 2023 (Figure 1c). Over the study period, there was an annual increase in mortality of 0.07 per 1,000 patients (95% CI 0.02 to 0.12). Elevated mortality rates were observed in males [SMR: 1.8 (95% CI: 1.7 to 1.8)] and females [SMR: 2.0 (95% CI: 2.0 to 2.1)], particularly among those aged 30–70 years. Regression models showed significantly higher all-cause mortality in the incident sarcoidosis cohort compared to matched controls [adjusted incidence rate ratio (IRR): 1.73 (95% CI: 1.63 to 1.83)] Figure 1Age and sex standardised incidence, prevalence and mortality of sarcoidosis in England
Conclusion:
The incidence and prevalence of sarcoidosis are rising in England, with notable rises amongst males and individuals aged 60 and older. Younger patients with sarcoidosis are at increased risk of death compared to matched controls. Acknowledging the growing burden of this disease, along with shifting demographic trends, is crucial for optimising healthcare policies and ensuring the effective allocation of healthcare resources.
