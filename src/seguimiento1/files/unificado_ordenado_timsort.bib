    keywords = {Cancer, Chemoresistance, Oncogene, Autophagy, Tumour microenvironment},
    title = {Chemoresistance: The hidden barrier in cancer treatment},
    url = {https://www.sciencedirect.com/science/article/pii/S2949713225000783},
    year = {2025}
}

