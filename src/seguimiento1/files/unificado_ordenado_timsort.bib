    pages = {106223},
    title = {Efficient fine-tuning of large language models for automated building energy modeling in complex cases},
    url = {https://www.sciencedirect.com/science/article/pii/S0926580525002638},
    volume = {175},
    year = {2025}
}

@article{LI202596,
    abstract = {Digital rock analysis (DRA) is fundamental for geo-energy research, enabling the characterisation of microstructures for applications like hydrocarbon recovery, carbon storage, and groundwater modelling. Although 2D CT images provide valuable pore-scale data, the scarcity of real-world datasets limits the effectiveness of advanced analysis. Generative AI presents a promising approach for synthesizing high-quality rock images but faces key challenges, including high computational demands, insufficient evaluation metrics, and the trade-off between image fidelity and diversity. To address these limitations, this study proposes the use of Low-Rank Adaptation (LoRA) for fine-tuning stable diffusion models, significantly reducing computational requirements while maintaining image quality. A systematic investigation was conducted to evaluate the influence of LoRA training parameters, including rank and learning rate, on the quality of generated images. Image outputs were assessed using both standard generative metrics, such as Kernel Inception Distance (KID), and domain-specific metrics, including porosity, pore count, and pore area distributions. The optimised LoRA-enhanced diffusion model achieved a 92.6 % reduction in KID relative to baseline models, while also improving inference speed. Building on these advancements, this study demonstrates that the LoRA-enhanced diffusion model significantly improves neural network extrapolation in incomplete data scenarios through statistically consistent synthetic generation. Despite control challenges, this approach reduces costs and enables diverse applications, bridging fundamental rock physics with practical energy research.},
    author = {Kunyao Li and Haijiang Li and Ali Khudhair and Jun Yan and Bin Wang},
    doi = {https://doi.org/10.1016/j.ige.2025.06.002},
    issn = {3050-6190},
    journal = {Intelligent Geoengineering},
    keywords = {Digital Rock Analysis, Stable Diffusion, Low-Rank Adaptation (LoRA), Computed Tomography (CT), Generative AI, Computational Geoscience},
    number = {2},
    pages = {96-108},
    title = {Efficient generation of digital rock CT images using LoRA-enhanced stable diffusion models},
    url = {https://www.sciencedirect.com/science/article/pii/S3050619025000151},
    volume = {2},
    year = {2025}
}

@article{YUAN2025133784,
    abstract = {Livestock wastewater causes severe pollution because of its high phosphorus concentration and difficult treatment process. For efficient phosphate recovery, different organic ligands are calcined herein using the metal-organic framework (MOF) template sacrificial method to synthesize nano-magnesium oxides (MgOs) with varying morphologies, pore structures, and vacancie concentrations (oxygen vacancy and Mg vacancy). 2,5-Dihydroxyterephthalic acid (DHTA)-MgO, 1,3,5-benzenetricarboxylic acid (H3BTC)-MgO, and adipic acid (AA)-MgO primarily rely on chemical adsorption, supplemented by physical adsorption. AA-MgO exhibits an adsorption capacity of 323.9 mg P/L for phosphate at pH8, which is 3.89 and 1.09 times higher than those of DHTA-MgO and H3BTC-MgO. X-ray photoelectron spectroscopy, electron paramagnetic resonance spectroscopy, and density functional theory calculations (DFT) confirm that the main mechanisms involved in phosphate adsorption are ligand exchange, intraspherical complexation, and electrostatic attraction. Moreover, the main phosphate adsorption sites on AA-MgO are oxygen vacancy, Mg, and Mg vacancy. When the inorganic phosphorus concentration = 38.39 ± 0.2 mg P/L, AA-MgO dosage = 1.2 g/L, the removal rate of phosphate in livestock wastewater reaches 100 %. Thus, the proposed method can be beneficial for improving the quality of acidic water bodies. This study provides a new approach for phosphate removal from livestock wastewater.},
    author = {Tian Yuan and Shiyu Lv and Xueyan Zhang and Yuan Luo and Menghan Feng and Weilin Fu and Pu Yang and Kerong Fu and Yanli Luo and Yanzhuan Cao and Feng Wang},
    doi = {https://doi.org/10.1016/j.seppur.2025.133784},
    issn = {1383-5866},
    journal = {Separation and Purification Technology},
    keywords = {MgO, MOFs sacrificial template, O vacancy, Mg vacancy, Phosphate recovery, DFT},
    pages = {133784},
    title = {Efficient recovery of high-concentration phosphorus from livestock wastewater: combined effects of magnesium-based metal-organic framework-derived metal oxide morphology and magnesium oxide different vacancie species},
    url = {https://www.sciencedirect.com/science/article/pii/S1383586625023810},
    volume = {374},
    year = {2025}
