    journal = {Computers and Education: Artificial Intelligence},
    keywords = {ChatGPT, Generative Artificial Intelligence, L2 writing in Thailand, L2 writing in Vietnam, Second language writing, Writing proficiency},
    pages = {100313},
    title = {Using ChatGPT for second language writing: Experiences and perceptions of EFL learners in Thailand and Vietnam},
