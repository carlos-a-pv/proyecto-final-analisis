    keywords = {ChatGPT, generative AI, simulated patient, health care, quality and safety, low- and middle-income countries, quality, LMIC, patient study, effectiveness, reliability, medication prescription, prescription, noncommunicable diseases, AI integration, AI, artificial intelligence},
    title = {Quality and Accountability of ChatGPT in Health Care in Low- and Middle-Income Countries: Simulated Patient Study},
