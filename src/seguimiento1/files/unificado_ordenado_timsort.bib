@article{SONG2025115500,
    abstract = {As global energy demand rises and environmental problems worsen, energy optimization in intelligent buildings has become a key research focus. This paper combines generative AI technology with 3D modeling to propose a spatial design method for energy optimization of intelligent buildings. This method employs generative AI to enhance the spatial layout of the building and iteratively optimizes energy consumption in the design scheme through several rounds of refinement. Experiments show that the design scheme using this method can significantly reduce building energy consumption. The energy consumption of the intelligent optimization design solution is 600 kWh lower than that of the traditional design solution across several types of buildings, including office buildings, residential areas, and public spaces. This reduction was observed under varying environmental conditions such as temperature and humidity, highlighting the adaptability and effectiveness of the intelligent optimization design solution. In addition, a comparative analysis of multiple building configurations and external environmental factors, such as varying spatial layouts, solar panel usage, and insulation materials, further validates the applicability of this intelligent design approach in different building types and operational settings. In addition, with the increase of spatial layout optimization, building energy efficiency has been improved, and the energy efficiency improvement ratio in some areas is close to 20 %. Solar photovoltaic panels offer the most significant energy efficiency improvement, increasing efficiency by 30 % with a long service life. Other renewable energy sources, such as geothermal and bioenergy, also enhance efficiency. Geothermal energy, for instance, improves efficiency by 20 % to 45 %, depending on location and system integration, and is particularly effective in climates with seasonal temperature variations, reducing heating and cooling energy demand. The optimization solution combining generative AI and 3D modeling not only improves the energy efficiency of buildings, but also provides a sustainable and low-carbon building design path. Through intelligent optimization, buildings can achieve lower energy consumption and higher energy utilization efficiency during use, providing strong technical support for the realization of green buildings.},
    author = {Jing Song},
    doi = {https://doi.org/10.1016/j.microc.2025.115500},
    issn = {0026-265X},
    journal = {Microchemical Journal},
    keywords = {Generative AI technology, 3D modeling, Energy optimization, Smart buildings, Sustainability},
    pages = {115500},
    title = {Research on energy optimization space design of intelligent buildings based on generative AI technology and 3D modeling},
    url = {https://www.sciencedirect.com/science/article/pii/S0026265X25028486},
    year = {2025}
}

@article{HAYOZ2025100670,
    abstract = {Despite the growing presence of family offices (FOs) in practice, research on FOs is still in its infancy. Through a systematic literature review (SLR) of 104 papers, we synthesize existing knowledge in the field by integrating insights from both academic and practitioner research. Our SLR provides a state-of-the-art understanding of FOs and identifies new avenues for research that combine theoretical insights with practical implications. Specifically, our research addresses three key questions: i) How has research on FOs evolved; ii) What do we know about FOs, and iii) How can researchers further contribute to the field? We find that current research focuses primarily on FOs as service providers, with limited attention to the perspective of families as need originators. By bridging academic and practitioner-oriented research, we propose a novel definition of FOs to advance the discourse in the field.},
    author = {Patrik Hayoz and Bingbing Ge and Alfredo {De Massis}},
