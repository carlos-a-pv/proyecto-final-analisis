    journal = {Cancer Pathogenesis and Therapy},
    keywords = {Carcinoma, Non-Small Cell Lung, Immunotherapy, Receptor, , Mutation, adverse events, Survival Analysis},
    title = {Efficacy of Chemotherapy Combined With Immunotherapy in Advanced Lung Adenocarcinoma Harboring Epidermal Growth Factor Receptor (EGFR) Exon 20 Insertion Mutations: A Retrospective Comparative Study},
    url = {https://www.sciencedirect.com/science/article/pii/S2949713225000989},
    year = {2025}
